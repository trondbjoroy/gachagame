# DNS A records -> this VPS: emberfall.fun, www.emberfall.fun, app.emberfall.fun, docs.emberfall.fun
# Caddy provisions Let's Encrypt TLS automatically.

# landing page (static)
emberfall.fun {
	root * /opt/gacha/landing
	file_server
	encode gzip
}

www.emberfall.fun {
	redir https://emberfall.fun{uri} permanent
}

# the game itself
app.emberfall.fun {
	encode gzip
	# the in-browser session wallet syncs with the fullnode through us
	# (some phones refuse direct connections to the node's host); this
	# also carries the wallet's websocket
	handle_path /hnode/* {
		# the partner node leads and the public node backs it up (2026-08-13).
		# `first` sends everything to the partner while it passes the health
		# check and falls to node1 the moment it does not, so a flap still
		# costs nobody a rediscovery.
		reverse_proxy https://node-partners.testnet.hathor.network https://node1.testnet.hathor.network {
			header_up Host {upstream_hostport}
			lb_policy first
			lb_retries 2
			lb_try_duration 5s
			fail_duration 45s
			max_fails 2
			unhealthy_status 5xx
			health_uri /v1a/health
			health_interval 15s
			# 10s, not 4s: both nodes answer anywhere between 0.2s and 15s,
			# so a tight probe benched whichever was slow at that moment. It
			# held the partner node down permanently and quietly sent every
			# session wallet to node1. Refusing 5xx traffic (above) is what
			# actually catches a sick node; the probe only needs to catch a
			# dead one.
			health_timeout 10s
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8090 {
			# stamp the real TCP peer; overwrites any client-sent value so the
			# app can trust it for rate limiting (leftmost XFF is spoofable)
			header_up X-Real-IP {remote_host}
		}
	}
}

# the game guide (static)
docs.emberfall.fun {
	root * /opt/gacha/guide
	file_server
	encode gzip
}
