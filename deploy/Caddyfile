# DNS A records -> this VPS: emberfall.fun, www.emberfall.fun, app.emberfall.fun, docs.emberfall.fun
# Caddy provisions Let's Encrypt TLS automatically.

# landing page (static)
emberfall.fun {
	root * /opt/gacha/landing
	file_server
	encode gzip
}

www.emberfall.fun {
	redir https://emberfall.fun{uri} permanent
}

# the game itself
app.emberfall.fun {
	encode gzip
	# the in-browser session wallet syncs with the fullnode through us
	# (some phones refuse direct connections to the node's host); this
	# also carries the wallet's websocket
	handle_path /hnode/* {
		# partner node first; the public node catches the traffic while the
		# partner is marked unhealthy (it 503s in bursts). GET reads retry
		# onto the healthy upstream within the same request.
		reverse_proxy https://node-partners.testnet.hathor.network https://node1.testnet.hathor.network {
			header_up Host {upstream_hostport}
			lb_policy first
			lb_retries 2
			lb_try_duration 6s
			fail_duration 45s
			max_fails 2
			unhealthy_status 5xx
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8090 {
			# stamp the real TCP peer; overwrites any client-sent value so the
			# app can trust it for rate limiting (leftmost XFF is spoofable)
			header_up X-Real-IP {remote_host}
		}
	}
}

# the game guide (static)
docs.emberfall.fun {
	root * /opt/gacha/guide
	file_server
	encode gzip
}
